.pio
.settings
.cproject
.cache
coredump.*
*/__pycache__
*.log
.vscode/
.clangd
compile_commands.json

/versioning

# Hybrid compile (custom_sdkconfig, env trgb-esp32-s3-ble4): generated on every build
/sdkconfig.*
/managed_components/
/.dummy/
include/version.h

/Tools/DL_Data/

# Python venv and caches for the Tools/ log tooling (see Tools/README.md --
# recreate with: python3 -m venv Tools/.venv). The venv ignores itself via
# its own .gitignore; listed here so it stays ignored if that is ever lost.
/Tools/.venv/
__pycache__/
.pytest_cache/

# Local state of the BikeLog upload service (raw rides + SQLite index). Lives
# outside the repo by default; this catches an explicitly relocated one.
/Tools/BikeLogService/state/
# Build leftovers of "pip install Tools/" (pyproject.toml)
/Tools/build/
/Tools/*.egg-info/

/.pydevproject

# CAD build environment / generated exports (regenerate via cad/*.py)
cad/.venv/
cad/export/
cad/TEMP_Fotos/

# Local archive of flashable firmware builds (binaries only, kept out of git
# history on purpose -- see firmware-archive/INDEX.md)
/firmware-archive/

# EEZ Studio: per-user editor state (selected page/panel layout, not project
# content) and the timestamped backups our edit scripts take before each
# mutation (EEZStudio/tmp/*.py) -- git itself is the real backup going forward.
EEZStudio/*.eez-project-ui-state
EEZStudio/*.bak.*

# EEZ Studio edit scripts (one-shot patches against the .eez-project)
EEZStudio/tmp
# bikelog raw replay: rq_replay, built on demand from src/RoadQuality.cpp
Tools/.build/

# Testtracks etc
Tools/TestData/

# Copied from the TrailBridge repo when the documentation site is built
# (doc/fetch_trailbridge.sh); the source of truth is ../TrailBridge/PROTOCOL.md
/doc/trailbridge/PROTOCOL.md
/doc/trailbridge/PROTOCOL.de.md

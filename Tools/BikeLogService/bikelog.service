# systemd unit for the bike log service -- template, install.sh fills in
# @USER@ and @PREFIX@ and writes the result to @PREFIX@/bikelog.service.
#
# A system unit with User= rather than a user unit: it needs no login session
# and no "loginctl enable-linger", and it starts at boot like everything else
# on the home server. Installing it is the one step that needs root:
#   sudo install -m 644 @PREFIX@/bikelog.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now bikelog

[Unit]
Description=BikeLog service (TRGB-BikeComputer): pulls and serves ride logs
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=@USER@
Group=@USER@
WorkingDirectory=@PREFIX@
# Configuration (data dir, pull targets, auth) -- see README.md.
EnvironmentFile=@PREFIX@/bikelog.env
ExecStart=@PREFIX@/venv/bin/bikelogservice serve --host 0.0.0.0 --port ${BIKELOG_PORT}

Restart=on-failure
RestartSec=5

# The service only ever writes below its data directory.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@PREFIX@/data

[Install]
WantedBy=multi-user.target
